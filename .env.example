# Your local timezone. Determines "today" and "yesterday" in the date filter.
# Use a TZ database name. Examples: America/New_York, America/Chicago, America/Los_Angeles
TZ=America/New_York

# Paths inside the container. These should match the volume mounts in
# docker-compose.yml. You usually don't need to change these.
DB_PATH=/data/gametimarr.db
DOWNLOAD_PATH=/downloads
DESTINATION_PATH=/watch

# Web UI port
WEB_PORT=8080