# Gametimarr Environment Variables

# Timezone for scheduling (default: America/New_York)
TZ=America/New_York

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# qBittorrent Settings (can also be set via Web UI)
QBIT_HOST=localhost
QBIT_PORT=8080
QBIT_USERNAME=admin
QBIT_PASSWORD=your_password_here

# Prowlarr Settings (can also be set via Web UI)
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your_api_key_here

# TheSportsDB API Key (can also be set via Web UI)
THESPORTSDB_API_KEY=your_api_key_here

# Search Schedule - Cron expression (default: every 4 hours)
# Examples:
#   "0 */4 * * *"  - Every 4 hours
#   "0 2 * * *"    - Daily at 2 AM
#   "*/30 * * * *" - Every 30 minutes
SEARCH_SCHEDULE=0 */4 * * *

# Sport Folder Paths (comma-separated: SPORT=PATH)
# Example: NCAAF=/media/Sports/NCAAF,NFL=/media/Sports/NFL,MLB=/media/Sports/MLB
SPORT_FOLDERS=NCAAF=/media/Sports/NCAAF,NFL=/media/Sports/NFL,MLB=/media/Sports/MLB